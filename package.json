{
    "name": "drag-to-swipe",
    "version": "0.1.0",
    "description": "Mouse drag scrolling for CSS scroll-snap carousels — momentum, snap and rubber-band overscroll. Touch keeps native scrolling.",
    "keywords": [
        "scroll-snap",
        "drag-scroll",
        "carousel",
        "slider",
        "horizontal-scroll",
        "momentum",
        "mouse-drag",
        "react"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/woneob/drag-to-swipe.git"
    },
    "homepage": "https://github.com/woneob/drag-to-swipe#readme",
    "bugs": {
        "url": "https://github.com/woneob/drag-to-swipe/issues"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react/index.d.ts",
                "default": "./dist/react/index.js"
            },
            "require": {
                "types": "./dist/react/index.d.cts",
                "default": "./dist/react/index.cjs"
            }
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && cp src/style.css dist/style.css",
        "dev": "vite demo",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
    },
    "peerDependencies": {
        "react": ">=17"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@11.20.0",
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^30.1.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^9.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "~5.0.5"
    }
}
